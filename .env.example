# Copy to .env and adjust. .env is git-ignored: NEVER commit real values.
#
# Phase 1 services need no secrets. Credentials (database, Kafka, OAuth2) arrive in later phases and
# are always injected through environment variables locally and a secrets manager in production.

# Active Spring profile for locally started services: dev | test | prod
SPRING_PROFILES_ACTIVE=dev

# Each service listens on its default port (see README) unless SERVER_PORT is set for that process, e.g.
#   SERVER_PORT=9082 ./mvnw -pl services/user-service spring-boot:run
