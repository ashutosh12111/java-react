# Copy to .env and adjust. .env is git-ignored: NEVER commit real values.
#
# Phase 1 services need no secrets. Credentials (database, Kafka, OAuth2) arrive in later phases and
# are always injected through environment variables locally and a secrets manager in production.

# Active Spring profile for locally started services: dev | test | prod
SPRING_PROFILES_ACTIVE=dev

# Each service listens on its default port (see README) unless SERVER_PORT is set for that process, e.g.
#   SERVER_PORT=9082 ./mvnw -pl services/user-service spring-boot:run

# --- Phase 2: service discovery by URL (defaults shown, for local processes) ---------------------
# Read by master-service (downstream calls) and api-gateway (routes). Docker Compose / Kubernetes
# (Phases 5 and 13) set these to internal DNS names such as http://order-service:8085.
USER_SERVICE_URL=http://localhost:8082
PRODUCT_SERVICE_URL=http://localhost:8083
INVENTORY_SERVICE_URL=http://localhost:8084
ORDER_SERVICE_URL=http://localhost:8085
PAYMENT_SERVICE_URL=http://localhost:8086
NOTIFICATION_SERVICE_URL=http://localhost:8087
MASTER_SERVICE_URL=http://localhost:8081

# Browser origins allowed to call the gateway (comma-separated). 5173 = Vite dev server (Phase 4).
ALLOWED_ORIGINS=http://localhost:5173
